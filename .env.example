# Copy this file to .env.local and fill in the value.
# .env.local is gitignored — NEVER commit a real key.
#
# Get a key at https://console.anthropic.com/
# Server-side only: this is read in app/api/triage/route.ts on the server.
# Do NOT rename it to NEXT_PUBLIC_* — that would ship the key to the browser.
#
# The app works WITHOUT this key (deterministic offline fallback). The key only
# upgrades the triage quality via Claude.
ANTHROPIC_API_KEY=
